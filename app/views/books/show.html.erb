<p style="color: green"><%= notice %></p>

<%= render @book %>

<div>
  <% editthisbook = t :Editthisbook %>
  <% backtobooks = t :Backtobooks %>
  <%= link_to editthisbook, edit_book_path(@book) %> |
  <%= link_to backtobooks, books_path %>

  <% destroythisbook = t :Destroythisbook %>
  <%= button_to destroythisbook, @book, method: :delete %>
</div>
