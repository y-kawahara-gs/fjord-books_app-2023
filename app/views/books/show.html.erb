<p style="color: green"><%= notice %></p>

<%= render @book %>

<div>
  <% edit_this_book = t :edit_this_book %>
  <% back_to_books = t :back_to_books %>
  <%= link_to edit_this_book, edit_book_path(@book) %> |
  <%= link_to back_to_books, books_path %>

  <% destroy_this_book = t '.destroy_this_book' %>
  <%= button_to destroy_this_book, @book, method: :delete %>
</div>
