<p style="color: green"><%= notice %></p>

<h1><%= t '.title' %></h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
    <% show_this_book = t :show_this_book %>
      <%= link_to show_this_book, book %>
    </p>
  <% end %>
</div>

<% new_book = t :new_book %>
<%= link_to new_book, new_book_path %>
