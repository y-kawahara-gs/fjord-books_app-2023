<p style="color: green"><%= notice %></p>

<h1><%= t :Books %></h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <% showthisbook = t :Showthisbook%>
      <%= link_to showthisbook, book %>
    </p>
  <% end %>
</div>

<% newbook = t :Newbook %>
<%= link_to newbook, new_book_path %>
