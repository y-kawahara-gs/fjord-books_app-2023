<div id="<%= dom_id report %>">
  <p>
  <strong><%= Report.human_attribute_name(:title) %>:</strong>
    <%= report.title %>
  </p>

  <p>
  <strong><%= Report.human_attribute_name(:content) %>:</strong>
    <%= report.content %>
  </p>

  <p>
  <strong><%= Report.human_attribute_name(:user) %>:</strong>
  <% if report.user.name.present? %>
    <%= report.user.name %>
  <% else %>
    <%= report.user.email %>
  <% end %>
  </p>

  <p>
  <strong><%= Report.human_attribute_name(:created_at) %>:</strong>
    <%= l report.created_at, format: :short %>
  </p>

  <p>
  <strong><%= Report.human_attribute_name(:updated_at) %>:</strong>
    <%= l report.updated_at, format: :short %>
  </p>

</div>
